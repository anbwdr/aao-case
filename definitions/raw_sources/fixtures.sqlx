    id: "Fixture id",
    location: "Stadium",
    home_team: "Home team (case naming)",
    away_team: "Away team (case naming)",
    starting_time: "Official kickoff, YYYY-MM-DD HH:MM:SS",
    _batch_id: "Batch folder name (UTC timestamp, sortable), set by the Workflow",
    _ingested_at: "Load timestamp, set by the Workflow",
    _source_file: "gs:// URI of the landed file",
  }
}
